                     schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)"
                     schemeID="4" schemeName="31">800197268</sts:AuthorizationProviderID>
               </sts:AuthorizationProvider>
               <sts:QRCode />
            </sts:DianExtensions>
         </ext:ExtensionContent>
      </ext:UBLExtension>
      <ext:UBLExtension>
         <ext:ExtensionContent></ext:ExtensionContent>
      </ext:UBLExtension>
   </ext:UBLExtensions>
  <cbc:UBLVersionID>UBL 2.1</cbc:UBLVersionID>
  <!-- 10 = vendedor residente (§16.1.4.1). Igual que el documento soporte. -->
  <cbc:CustomizationID>10</cbc:CustomizationID>
  <!-- Literal exacto exigido por NSAD03. La regla compara por igualdad ("si
       este elemento no equivale al literal"), así que un solo carácter de más
       lo rechaza: SIN espacio final, termina en "equivalente".
       El §8.2 lo muestra con un espacio antes de la comilla, pero es un
       artefacto del salto de línea del PDF; en la sección de reglas (§10.3) el
       literal aparece dos veces con la comilla pegada a la palabra. -->
  <cbc:ProfileID>DIAN 2.1: Nota de ajuste al documento soporte en adquisiciones efectuadas a sujetos no obligados a expedir factura o documento equivalente</cbc:ProfileID>
  <cbc:ProfileExecutionID>1</cbc:ProfileExecutionID>
  <cbc:ID>NAS1</cbc:ID>
  <cbc:UUID schemeID="1" schemeName="CUDS-SHA384" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)"></cbc:UUID>
  <cbc:IssueDate>2025-11-07</cbc:IssueDate>
  <cbc:IssueTime>00:00:00-05:00</cbc:IssueTime>
  <!-- 95 = nota de ajuste al documento soporte (§16.1.3) -->
  <cbc:CreditNoteTypeCode>95</cbc:CreditNoteTypeCode>
  <cbc:Note></cbc:Note>
  <cbc:DocumentCurrencyCode>COP</cbc:DocumentCurrencyCode>
  <cbc:LineCountNumeric>1</cbc:LineCountNumeric>
  <!-- Naturaleza de la corrección (NSBF01-04). ResponseCode según §16.2.4:
       1 devolución parcial · 2 anulación · 3 rebaja o descuento ·
       4 ajuste de precio · 5 otros -->
  <cac:DiscrepancyResponse>
    <cbc:ReferenceID></cbc:ReferenceID>
    <cbc:ResponseCode>2</cbc:ResponseCode>
    <cbc:Description></cbc:Description>
  </cac:DiscrepancyResponse>
  <!-- Documento soporte corregido (NSBG01-05). El UUID es su CUDS;
       la DIAN rechaza la nota si no se reporta. -->
  <cac:BillingReference>
    <cac:InvoiceDocumentReference>
      <cbc:ID></cbc:ID>
      <cbc:UUID schemeName="CUDS-SHA384"></cbc:UUID>
      <cbc:IssueDate></cbc:IssueDate>
    </cac:InvoiceDocumentReference>
  </cac:BillingReference>
  <!-- Roles invertidos respecto a una venta: el proveedor (SNO) es el
       AccountingSupplierParty y mi empresa (ABS) el AccountingCustomerParty. -->
  <cac:AccountingSupplierParty>
    <cbc:AdditionalAccountID schemeAgencyID="195">2</cbc:AdditionalAccountID>
    <cac:Party>
      <cac:PhysicalLocation>
        <cac:Address>
          <cbc:ID>11001</cbc:ID>
          <cbc:CityName>Bogotá, D.C</cbc:CityName>
          <cbc:PostalZone>111011</cbc:PostalZone>
          <cbc:CountrySubentity>Bogotá</cbc:CountrySubentity>
          <cbc:CountrySubentityCode>11</cbc:CountrySubentityCode>
          <cac:AddressLine>
            <cbc:Line>AV EL DORADO 100-80</cbc:Line>
          </cac:AddressLine>
          <cac:Country>
            <cbc:IdentificationCode>CO</cbc:IdentificationCode>
            <cbc:Name languageID="es">Colombia</cbc:Name>
          </cac:Country>
        </cac:Address>
      </cac:PhysicalLocation>
      <cac:PartyTaxScheme>
        <cbc:RegistrationName>PROVEEDOR</cbc:RegistrationName>
        <cbc:CompanyID schemeID="6" schemeName="31" schemeAgencyID="195" schemeAgencyName="CO, DIAN (Dirección de Impuestos y Aduanas Nacionales)">23689250</cbc:CompanyID>
        <cbc:TaxLevelCode listName="5">R-99-PN</cbc:TaxLevelCode>
        <cac:TaxScheme>
          <cbc:ID>ZZ</cbc:ID>
          <cbc:Name>No aplica</cbc:Name>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
    </cac:Party>
  </cac:AccountingSupplierParty>
  <cac:AccountingCustomerParty>
    <cbc:AdditionalAccountID schemeAgencyID="195">1</cbc:AdditionalAccountID>
    <cac:Party>
      <cac:PhysicalLocation>
        <cac:Address>
          <cbc:ID>11001</cbc:ID>
          <cbc:CityName>Bogotá, D.C</cbc:CityName>
          <cbc:PostalZone>11111</cbc:PostalZone>
          <cbc:CountrySubentity>Bogotá</cbc:CountrySubentity>
          <cbc:CountrySubentityCode>11</cbc:CountrySubentityCode>
          <cac:AddressLine>
            <cbc:Line>CRA 73 A # 55 - 40</cbc:Line>
          </cac:AddressLine>
          <cac:Country>
            <cbc:IdentificationCode>CO</cbc:IdentificationCode>
            <cbc:Name languageID="es">Colombia</cbc:Name>
          </cac:Country>
        </cac:Address>
